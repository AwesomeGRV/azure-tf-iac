# Azure Infrastructure Configuration Example
# Copy this file to terraform.tfvars and update with your values

# Core Infrastructure
location = "East US"
environment = "production"
prefix = "azinfra"

# Tags
tags = {
  "ManagedBy"     = "Terraform"
  "Environment"   = "production"
  "CostCenter"    = "IT"
  "Compliance"    = "SOC2"
  "DataClassification" = "Confidential"
  "Project"       = "AzureInfrastructure"
  "Owner"         = "CloudTeam"
}

# Networking
vnet_address_space = ["10.0.0.0/16"]

# Compute Configuration
aks_node_count = 3
aks_vm_size = "Standard_D2s_v3"
admin_username = "azureadmin"
admin_ssh_key = "ssh-rsa AAAAB3NzaC1yc2EAAAADAQABAAABAQC..."

# Storage Configuration
storage_account_tier = "Standard"
storage_account_replication_type = "ZRS"
mysql_administrator_login = "mysqladmin"
mysql_sku_name = "GP_Gen5_2"

# Application Services
app_service_plan_sku = "P1v2"
function_app_sku = "EP1"

# Monitoring
enable_monitoring = true
log_retention_days = 30

# Additional Services Configuration
# API Management
apim_sku_name = "Developer_1"
apim_publisher_name = "API Management Team"
apim_publisher_email = "api-team@example.com"

# CDN Configuration
cdn_sku_name = "Standard_Microsoft"

# Front Door Configuration
front_door_sku_name = "Standard_AzureFrontDoor"
enable_waf = true

# Notification Hubs
notification_hub_sku = "Free"
notification_hub_namespace = "notification-namespace"

# Cognitive Services (disabled by default)
enable_cognitive_services = false
cognitive_services_sku = "S0"

# Data Factory (disabled by default)
enable_data_factory = false
data_factory_sku = "GP"
